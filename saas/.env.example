NODE_ENV=development
HOST=0.0.0.0
PORT=8090
SAAS_JWT_SECRET=replace-with-a-long-random-secret
# Only the literal "true" opens registration. Unset means open in development
# and, in production, open only while SAAS_REGISTRATION_TOKEN is set.
SAAS_ALLOW_REGISTRATION=true
# When set, /api/auth/register also requires a matching registrationToken
SAAS_REGISTRATION_TOKEN=
# Base URL used to build invitation links; without it the Host header is used.
SAAS_PUBLIC_URL=
SAAS_MAX_UPLOAD_MB=10
# Import caps; a CSV beyond either is rejected with 413.
SAAS_MAX_IMPORT_COLUMNS=256
SAAS_MAX_IMPORT_ROWS=20000
# Number of trusted reverse proxies in front of the app; 0 means none.
SAAS_TRUSTED_PROXIES=0

# Local development uses SQLite when DATABASE_URL is empty.
SAAS_DB_PATH=./data/saas.sqlite

# Staging/production uses managed PostgreSQL.
# DATABASE_URL=postgresql://user:password@host:5432/database
# DATABASE_SSL=true
# PGSSL_REJECT_UNAUTHORIZED=true
# DATABASE_POOL_MAX=10
