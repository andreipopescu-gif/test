NODE_ENV=development
HOST=0.0.0.0
PORT=8090
SAAS_JWT_SECRET=
# Set to false for an invite-only pilot (blocks /api/auth/register)
SAAS_ALLOW_REGISTRATION=true
SAAS_MAX_UPLOAD_MB=10replace-with-a-long-random-secret

# Local development uses SQLite when DATABASE_URL is empty.
SAAS_DB_PATH=./data/saas.sqlite

# Staging/production uses managed PostgreSQL.
# DATABASE_URL=postgresql://user:password@host:5432/database
# DATABASE_SSL=true
# PGSSL_REJECT_UNAUTHORIZED=true
# DATABASE_POOL_MAX=10
